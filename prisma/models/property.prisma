// ==========================================
// 🏢 1. PROPRIÉTÉ (PROPERTY)
// ==========================================

model Property {
  id String @id @default(cuid())

  // --- 🔐 Multi-tenant & Audit (Clerk) ---
  organizationId String // ID de l'agence (Clerk)
  createdById    String // ID de l'agent (Clerk)

  // --- 📝 Infos Générales ---
  reference    String // ex: REF-2026-001
  designation  String
  description  String?      @db.Text
  propertyType PropertyType

  // --- 📍 Localisation ---
  address      String  @db.Text
  country      String  @default("Cameroun")
  city         String
  neighborhood String?
  zone         String?

  // --- 📐 Caractéristiques ---
  area       Float? // Surface (m²)
  roomsCount Int?
  floor      String?

  // --- 📜 Légal & Cadastral ---
  landTitle        String? // Titre foncier
  parcelNumber     String? // N° Parcelle
  cadastralSection String?

  // --- 💰 Financier ---
  baseRent        Decimal         @db.Decimal(10, 2)
  currentRent     Decimal?        @db.Decimal(10, 2)
  currency        String          @default("XAF")
  commissionType  CommissionType?
  commissionValue Float?

  // --- 📊 Statut ---
  status PropertyStatus @default(AVAILABLE)

  // --- 🔗 Relations ---
  images PropertyImage[] // Galerie d'images (Cloudflare R2)
  owners PropertyOwner[] // Liste des propriétaires (Indivision)

  currentLeaseId String? @unique
  currentLease   Lease?  @relation("CurrentLease", fields: [currentLeaseId], references: [id], onDelete: SetNull)
  leaseHistory   Lease[] @relation("PropertyLeases")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([status])
  @@index([city])
}

// ==========================================
// 🖼️ 2. IMAGES / MÉDIAS (Cloudflare R2)
// ==========================================

model PropertyImage {
  id String @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // --- ☁️ Cloudflare R2 ---
  url     String // URL publique
  fileKey String // Clé exacte de l'objet (requis pour suppression)

  // --- 🏷️ Métadonnées ---
  isCover   Boolean @default(false)
  caption   String?
  sortOrder Int     @default(0)
  size      Int?
  mimeType  String?

  createdAt DateTime @default(now())

  @@unique([propertyId, fileKey])
  @@index([propertyId])
}
