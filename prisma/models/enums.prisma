// ==========================================
// 📋 7. ÉNUMÉRATIONS (ENUMS)
// ==========================================

enum PropertyType {
  APARTMENT
  VILLA
  STUDIO
  COMMERCIAL_SPACE
  LAND
  WAREHOUSE
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  UNDER_MAINTENANCE
  UNAVAILABLE
}

enum CommissionType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum LegalEntityType {
  INDIVIDUAL
  COMPANY
}

enum LeaseStatus {
  DRAFT // Brouillon / En cours de signature
  ACTIVE // En cours
  TERMINATED // Résilié
  EXPIRED // Arrivé à terme
}

enum PaymentFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
}

enum ScheduleStatus {
  PENDING // En attente (la date limite n'est pas encore passée)
  PARTIAL // Payé partiellement
  PAID // Entièrement payé
  OVERDUE // En retard (date limite dépassée, non soldé)
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
}
