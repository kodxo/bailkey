// ==========================================
// 🧑‍💼 5. LOCATAIRE (TENANT)
// ==========================================

model Tenant {
  id             String @id @default(cuid())
  organizationId String

  clerkUserId String?         @unique // Portail locataire
  type        LegalEntityType @default(INDIVIDUAL)

  firstName        String?
  lastName         String?
  identityDocument String? // CNI / Passeport

  companyName        String?
  registrationNumber String? // RCCM
  taxNumber          String? // NIU / NIF

  email   String?
  phone   String?
  address String? @db.Text

  leases Lease[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}
